{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@rds/sandbox-contracts": ["../packages/sandbox-contracts/dist/index.d.ts"],
      "@rds/sandbox-core": ["../packages/sandbox-core/dist/index.d.ts"],
      "@rds/sandbox-react": ["../packages/sandbox-react/dist/index.d.ts"],
      "@rds/sandbox-echarts": ["../packages/sandbox-echarts/dist/index.d.ts"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}

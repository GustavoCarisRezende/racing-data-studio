{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Racing Data Studio",
  "version": "0.0.1-beta.1",
  "identifier": "org.racingdatastudio.app",
  "build": {
    "beforeDevCommand": "npm run build && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "Racing Data Studio", "width": 1024, "height": 720, "minWidth": 360, "minHeight": 480, "maximized": true }],
    "security": { "csp": "default-src 'self'; style-src 'self'; img-src 'self' asset: blob:; connect-src 'self' ipc: http://ipc.localhost", "capabilities": ["f1-main"] }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "wix": { "upgradeCode": "bd230f66-5b74-558e-bdff-6443a33f05ce" }
    }
  },
  "plugins": { "updater": { "pubkey": "", "requireSignedVersion": true, "windows": { "installMode": "passive" } } }
}

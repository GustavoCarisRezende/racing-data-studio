{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Racing Data Studio",
  "version": "0.1.0",
  "identifier": "org.racingdatastudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Racing Data Studio", "width": 1024, "height": 720, "minWidth": 360, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; img-src 'self' asset:; connect-src 'self' ipc: http://ipc.localhost", "capabilities": ["f1-main"] }
  },
  "bundle": { "active": false }
}
